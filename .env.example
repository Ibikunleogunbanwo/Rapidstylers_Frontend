# Copy to .env and fill in real values — .env is gitignored.

# Must match APP_API_KEY in Rapidstylers_Backend/.env
REACT_APP_API_KEY=your_api_key

REACT_APP_API_BASE_URL=http://localhost:9090/rapid_stylers

REACT_APP_DECRYPT_KEY=your_decrypt_key

# Google AdSense publisher ID (ca-pub-XXXX). Leave empty until approved.
REACT_APP_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
