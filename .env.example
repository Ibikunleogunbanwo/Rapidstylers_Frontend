# Copy to .env and fill in real values — .env is gitignored.

# Must match APP_API_KEY in Rapidstylers_Backend/.env
REACT_APP_API_KEY=your_api_key

# MUST be https:// in production. Plain HTTP exposes JWT and user data in transit.
REACT_APP_API_BASE_URL=https://your-api-domain.com/rapid_stylers


# Google Maps — restrict this key to your production domain in Google Cloud Console.
# Google Sign-In OAuth Client ID (Web application). Public, safe to ship.
# Empty disables the Continue-with-Google button on the login page.
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id

REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_key

# Google AdSense publisher ID (ca-pub-XXXX). Leave empty until approved.
REACT_APP_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Cloudflare Turnstile site key (public). Pairs with TURNSTILE_SECRET_KEY in
# Rapidstylers_Backend/.env — set BOTH or NEITHER: the frontend challenge is
# inert while this is empty, and the backend stops requiring a token when its
# secret is empty, so setting only one of them breaks sign-in.
REACT_APP_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Stripe mode switch: "test" or "live". Empty falls back to the legacy
# REACT_APP_STRIPE_PUBLISHABLE_KEY below.
REACT_APP_STRIPE_MODE=test
REACT_APP_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your_key
REACT_APP_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your_key
# Legacy single publishable key (used only when REACT_APP_STRIPE_MODE is empty).
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Facebook App ID (numbers only, from developers.facebook.com > your app >
# Settings > Basic). Adds fb:app_id to link previews for Insights and ads
# reporting. Live site only; leave unset on the demo.
REACT_APP_FACEBOOK_APP_ID=

# Demo showroom build only (the second Vercel project for demo.rapidstylers.ca).
# true sends sign-up, login and booking to the live site and tells search
# engines not to index the demo.
# Leave unset on the live site.
REACT_APP_DEMO_MODE=
# For payment QA on the demo deployment, use npm run build:demo-qa.
# That build pins the demo API + Stripe test mode and opens local account/booking
# flows even if the Vercel project's normal showroom env has DEMO_MODE=true.
# Requires REACT_APP_STRIPE_TEST_PUBLISHABLE_KEY; retains noindex HTML.
# Demo only: true after launch, so the demo's booking button sends visitors to
# the live site. Leave unset before launch (the form opens, submit is disabled).
REACT_APP_DEMO_BOOKING_OPEN=
REACT_APP_LIVE_SITE_URL=https://rapidstylers.ca

# ── API proxy (server-only: set in the Vercel project, NOT as REACT_APP_*) ──
# With these set, point REACT_APP_API_BASE_URL at "/rapid_stylers" and remove
# REACT_APP_API_KEY: the browser then calls this site's own domain and never
# sees the API host or key. See src/proxy/apiProxy.mjs.
API_UPSTREAM_URL=https://api.rapidstylers.ca
API_KEY=
FRONTEND_PROXY_SECRET=
